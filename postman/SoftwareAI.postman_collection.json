{
  "info": {
    "name": "SoftwareAI - Plataforma de Inscripciones a Cursos",
    "description": "Flujo completo de la API: registro, login, roles, cursos, inscripciones, cupos y cancelaciones.\n\nLas peticiones estan ordenadas para ejecutarse con el Collection Runner de arriba hacia abajo. Las cookies de sesion las maneja Postman automaticamente; los ids se guardan solos en variables de la coleccion.\n\nAntes de correr: `npm run seed`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081/api" },
    { "key": "adminEmail", "value": "admin@softwareai.com.mx" },
    { "key": "adminPass", "value": "Admin123" },
    { "key": "organizerEmail", "value": "instructor@softwareai.com.mx" },
    { "key": "organizerPass", "value": "Organizer123" },
    { "key": "organizer2Email", "value": "instructor2@softwareai.com.mx" },
    { "key": "organizer2Pass", "value": "Organizer123" },
    { "key": "userEmail", "value": "estudiante@softwareai.com.mx" },
    { "key": "userPass", "value": "Usuario123" },
    { "key": "categoryId", "value": "" },
    { "key": "eventId", "value": "" },
    { "key": "ticketId", "value": "" }
  ],
