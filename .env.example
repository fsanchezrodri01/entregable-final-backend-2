# --- Servidor ---
PORT=8081
NODE_ENV=development

# --- Base de datos ---
# Docker local: mongodb://admin:password@127.0.0.1:27017/softwareai?authSource=admin
MONGO_URL=mongodb://127.0.0.1:27017/softwareai

# --- Autenticacion ---
JWT_SECRET=cambiar_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=1h

# --- Correo (Nodemailer) ---
# Si MAIL_HOST queda vacio, los correos se registran en consola y no se envian.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=SoftwareAI <info@softwareai.com.mx>
